{
  "name": "suite",
  "version": "0.1.0",
  "private": true,
  "description": "Private business and life management suite",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "start": "npm start -w server",
    "build": "npm run build -w client",
    "test": "npm test -w shared && npm test -w server && npm test -w client && npm run build -w client",
    "test:e2e": "npm run build -w client && node --test --test-concurrency=1 \"test/e2e/*.e2e.test.js\"",
    "test:wom": "node scripts/wom-e2e.mjs",
    "backup": "npm run backup -w server --",
    "restore": "npm run restore -w server --",
    "user:add": "npm run users -w server -- add",
    "user:list": "npm run users -w server -- list",
    "user:password": "npm run users -w server -- password",
    "user:reset-2fa": "npm run users -w server -- reset-2fa",
    "user:unlock": "npm run users -w server -- unlock"
  },
  "devDependencies": {
    "playwright-core": "1.56.0"
  }
}
