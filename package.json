{
  "name": "suite",
  "version": "0.1.0",
  "private": true,
  "description": "Private business and life management suite",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "start": "npm start -w server",
    "build": "npm run build -w client",
    "test": "npm test -w shared && npm test -w server && npm run build -w client",
    "backup": "npm run backup -w server --",
    "restore": "npm run restore -w server --"
  }
}
