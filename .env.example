# Copy to .env (git-ignored). docker compose reads it automatically.

# Off-machine backup folder ON THE MAC, mounted into the container at /offsite.
# Use a folder that is synced or stored somewhere else, e.g.
#   iCloud Drive:  /Users/<you>/Library/Mobile Documents/com~apple~CloudDocs/Suite Backups
#   Google Drive:  /Users/<you>/Library/CloudStorage/GoogleDrive-<account>/My Drive/Suite Backups
#   NAS share:     /Volumes/<share>/suite-backups   (add /Volumes in Docker Desktop file sharing)
# It must contain an empty file named .suite-backup-target (see DEPLOY.md).
SUITE_OFFSITE_DIR=

# Local time zone for the backup schedule and logs.
TZ=America/Toronto
# Nightly backup time, 24-hour HH:MM in TZ.
BACKUP_TIME=03:15
# Days of backups to keep (in both the local and the off-machine folder; the newest is always kept).
BACKUP_KEEP_DAYS=30

# Port on the Mac's 127.0.0.1 (the Wholesale Order Manager uses others).
SUITE_PORT=3100

# ---- Sign-in ----
# Sessions end after this many days unused, and in any case this many days after signing in.
SESSION_IDLE_DAYS=30
SESSION_MAX_DAYS=90
# Leave empty unless sign-in says "Request from another origin" (DEPLOY.md, Troubleshooting).
# Comma-separated, e.g. https://mac-mini.tail1234.ts.net:8443
ALLOWED_ORIGINS=
# Proxies whose X-Forwarded-* headers are believed. The compose default is right for
# Docker Desktop + Tailscale Serve; outside Docker the default is loopback.
# TRUST_PROXY=loopback, uniquelocal

# ---- Order Manager connection (D1) ----
# The address the Connections page shows for the Order Manager's Settings → Suite connection.
# Leave empty: http://host.docker.internal:<SUITE_PORT> (the Order Manager's container on this Mac).
WOM_CONNECT_URL=

# ---- Task calendar feed (C6a) ----
# The suite's Tailscale address, exactly as opened on the iPhone (e.g. https://mac-mini.tail1234.ts.net:8443).
# Calendar links and "Open in the suite" links use it. Leave empty: the address the page / calendar used.
SUITE_URL=
# The zone tasks' times are in (default: TZ above).
# CALENDAR_TIME_ZONE=America/Toronto

# ---- Stockroom (D16) ----
# Nothing to set: Stockroom's address, key and secret are pasted on System → Connections → Stockroom (the code from
# Stockroom → Settings → Connections → Connect the suite) and kept in the database, the secret encrypted.
# STOCKROOM_TIMEOUT_MS=15000      # each call to Stockroom gives up after this long
# STOCKROOM_PULL_ENABLED=true     # the pulls (on in production); Pull now on the card works either way

# ---- Only for running outside Docker (npm start / npm run dev) ----
# HOST=127.0.0.1
# PORT=3100
# DATA_DIR=./data
# BACKUP_DIR=./data/backups
# BACKUP_OFFSITE_DIR=
# BACKUP_ENABLED=false
# AUTOMATIONS_ENABLED=false   # the automation scheduler (on in production); Run now works either way
# WOM_KEY_FILE=./data/wom-secret.key   # encrypts the Order Manager's shared secret (kept out of backups)
# STOCKROOM_KEY_FILE=./data/stockroom-secret.key   # encrypts Stockroom's read secret (kept out of backups)
# AUTH_SCRYPT_N=65536     # password hashing cost (power of two); tests use less
