# Copy to .env (git-ignored). docker compose reads it automatically.

# Off-machine backup folder ON THE MAC, mounted into the container at /offsite.
# Use a folder that is synced or stored somewhere else, e.g.
#   iCloud Drive:  /Users/<you>/Library/Mobile Documents/com~apple~CloudDocs/Suite Backups
#   Google Drive:  /Users/<you>/Library/CloudStorage/GoogleDrive-<account>/My Drive/Suite Backups
#   NAS share:     /Volumes/<share>/suite-backups   (add /Volumes in Docker Desktop file sharing)
# It must contain an empty file named .suite-backup-target (see DEPLOY.md).
SUITE_OFFSITE_DIR=

# Local time zone for the backup schedule and logs.
TZ=America/Toronto
# Nightly backup time, 24-hour HH:MM in TZ.
BACKUP_TIME=03:15
# Days of backups to keep (in both the local and the off-machine folder; the newest is always kept).
BACKUP_KEEP_DAYS=30

# Port on the Mac's 127.0.0.1 (the Wholesale Order Manager uses others).
SUITE_PORT=3100

# ---- Sign-in ----
# Sessions end after this many days unused, and in any case this many days after signing in.
SESSION_IDLE_DAYS=30
SESSION_MAX_DAYS=90
# Leave empty unless sign-in says "Request from another origin" (DEPLOY.md, Troubleshooting).
# Comma-separated, e.g. https://mac-mini.tail1234.ts.net:8443
ALLOWED_ORIGINS=
# Proxies whose X-Forwarded-* headers are believed. The compose default is right for
# Docker Desktop + Tailscale Serve; outside Docker the default is loopback.
# TRUST_PROXY=loopback, uniquelocal

# ---- Only for running outside Docker (npm start / npm run dev) ----
# HOST=127.0.0.1
# PORT=3100
# DATA_DIR=./data
# BACKUP_DIR=./data/backups
# BACKUP_OFFSITE_DIR=
# BACKUP_ENABLED=false
# AUTH_SCRYPT_N=65536     # password hashing cost (power of two); tests use less
